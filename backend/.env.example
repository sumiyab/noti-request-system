# Local development against the Docker emulators (docker compose up -d). Bun loads .env.local automatically.
TABLE_NAME=notification-requests-local
QUEUE_URL=http://localhost:9324/000000000000/notification-requests
MAX_ATTEMPTS=3
SIMULATED_FAILURE_RATE=0.2
LOG_LEVEL=debug

# Point the AWS SDK at the emulators. Unset in Lambda, where the SDK talks to real AWS.
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_ENDPOINT_URL_SQS=http://localhost:9324
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
